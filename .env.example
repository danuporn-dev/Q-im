# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qim_dev
DB_USER=
DB_PASSWORD=

# LINE, see docs/line-setup.md. CHANNEL_SECRET and ACCESS_TOKEN belong to the Messaging API channel.
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Minutes an order may stay READY before the shop is alerted and may cancel it as a no-show (1-1440)
READY_ALERT_MINUTES=20

# Development seed only; at least 12 characters
SEED_DEMO_PASSWORD=

# Seconds between status updates on open pages, 2 to 60. Empty: 6 to 10 depending on the page.
POLL_SECONDS=

# Addresses of reverse proxies whose X-Forwarded-For/Host/Proto are believed, comma separated. Empty: none.
# ngrok on this computer: 127.0.0.1,::1
TRUSTED_PROXY=

# Development only: code that visitors must enter before the one-tap demo sign-in. Use 8 or more characters.
# Empty: no code is asked. Always set it before opening the demo to the internet.
DEMO_ACCESS_CODE=

# true: the demo is open to the internet. Clients get no error details, stack traces or environment information;
# the server log stays the same.
DEMO_PUBLIC=false

# Crowd level: percent of a shop's limit (max active orders, or capacity) from which it counts as medium or high
CROWD_MEDIUM_PERCENT=40
CROWD_HIGH_PERCENT=75

# Hours a pickup QR works after the order is ready (1-72)
PICKUP_TOKEN_HOURS=12
# Optional, 32 characters or more: key for pickup tokens. Empty: a random key is created in storage/keys/.
PICKUP_TOKEN_KEY=
