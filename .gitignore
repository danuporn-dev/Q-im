# Secrets
.env
.env.*
!.env.example

# Private storage (logs, uploads)
/storage/**
!/storage/**/
!/storage/**/.gitkeep
!/storage/uploads/.htaccess

# Local dumps, editor and OS files
*.log
*.sql.gz
/backups/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Demo photos stay on the presenting computer (docs/demo.md); their credits list and the lock are committed
/public/assets/demo-food/*
!/public/assets/demo-food/.gitkeep
!/public/assets/demo-food/.htaccess
!/public/assets/demo-food/CREDITS.md
