# Secrets
.env
.env.*
!.env.example

# Private storage (logs, uploads)
/storage/**
!/storage/**/
!/storage/**/.gitkeep
!/storage/uploads/.htaccess

# Local dumps, editor and OS files
*.log
*.sql.gz
/backups/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Demo photos stay on the presenting computer
/public/assets/images/demo/*
!/public/assets/images/demo/.gitkeep
