# Re-open only the document root (see ../.htaccess).
Require all granted
Options -Indexes
DirectoryIndex index.php index.html

# Failures before the scripts start, such as an oversized upload, must not show paths or versions either.
ServerSignature Off
<IfModule php_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
</IfModule>

# Apache would redirect "/customer" to an absolute http:// address, which is wrong behind an HTTPS proxy.
DirectorySlash Off
RewriteEngine On
RewriteOptions AllowNoSlash
RewriteRule ^(customer|merchant|admin)$ index.php [L]
RewriteRule ^api/v1(/|$) api/index.php [L]

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    # Without this a browser guesses how long to keep pages and scripts, and shows an old version after an update.
    # The ETag still saves the download when nothing changed.
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
