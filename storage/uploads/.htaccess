# Pictures are sent by the API (App\Services\Images::output) as image/jpeg, never by the web server.
# The project's top .htaccess already blocks everything outside public/; this folder stays closed even
# if that file is lost or the folder is moved under the document root: nothing here may be served or run.
Require all denied
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php5 .php7 .php8 .pht .phps
RemoveType .php .phtml .phar .php5 .php7 .php8 .pht .phps
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
